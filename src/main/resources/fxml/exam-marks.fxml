<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.classbuddy.controller.ExamMarksController">

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <!-- Sidebar -->
    <VBox prefWidth="250" minWidth="250" maxWidth="250" styleClass="sidebar" VBox.vgrow="ALWAYS">
        <VBox styleClass="sidebar-header" alignment="CENTER">
            <Label text="Exams" styleClass="sidebar-logo" />
        </VBox>

        <VBox styleClass="sidebar-menu" spacing="5" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="10" bottom="10" />
            </padding>

            <Button onAction="#goBack" styleClass="sidebar-item" text="Back to Dashboard" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
        </VBox>
    </VBox>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" fitToHeight="true" HBox.hgrow="ALWAYS">
        <VBox spacing="18" styleClass="main-container">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Exam &amp; Marks" styleClass="page-title"/>
            </HBox>

            <Separator />

            <!-- Form -->
            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="140" prefWidth="160"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Classroom" GridPane.rowIndex="0"/>
                <ComboBox fx:id="classroomCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>

                <Label text="Type" GridPane.rowIndex="1"/>
                <ComboBox fx:id="typeCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>

                <Label text="Exam" GridPane.rowIndex="2"/>
                <ComboBox fx:id="examCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>

                <Label text="CT/Quiz" GridPane.rowIndex="3"/>
                <ComboBox fx:id="ctCombo" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity"/>

                <Label text="Lab Test" GridPane.rowIndex="4"/>
                <ComboBox fx:id="labCombo" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>

                <Label text="Roll Number" GridPane.rowIndex="5"/>
                <TextField fx:id="rollField" promptText="e.g., 23-001" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Score / Total" GridPane.rowIndex="6"/>
                <HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1">
                    <TextField fx:id="scoreField" promptText="Score" maxWidth="120"/>
                    <TextField fx:id="totalField" promptText="Total" maxWidth="120"/>
                </HBox>

                <Label text="Grade" GridPane.rowIndex="7"/>
                <TextField fx:id="gradeField" promptText="A+" GridPane.rowIndex="7" GridPane.columnIndex="1" maxWidth="120"/>

                <Label text="Remarks" GridPane.rowIndex="8"/>
                <TextArea fx:id="remarksArea" prefRowCount="2" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
                <Button text="Delete Selected" styleClass="btn-danger" onAction="#handleDeleteSelected"/>
                <Label fx:id="statusLabel"/>
            </HBox>

            <VBox spacing="8">
                <Label text="Recent Entries" styleClass="field-label"/>
                <HBox spacing="8">
                    <Label text="Filter by Roll" />
                    <TextField fx:id="filterRollField" promptText="e.g., 23-001" maxWidth="180" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Select a row to load it into the form" styleClass="info-text" />
                </HBox>
                <TableView fx:id="recentTable" prefHeight="260">
                    <columns>
                        <TableColumn fx:id="typeCol" text="Type" prefWidth="90" />
                        <TableColumn fx:id="itemCol" text="Item" prefWidth="90" />
                        <TableColumn fx:id="rollCol" text="Roll" prefWidth="140" />
                        <TableColumn fx:id="scoreCol" text="Score" prefWidth="120" />
                        <TableColumn fx:id="gradeCol" text="Grade" prefWidth="80" />
                        <TableColumn fx:id="remarksCol" text="Remarks" prefWidth="260" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
