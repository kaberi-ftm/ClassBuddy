<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import java.lang.String?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.classbuddy.controller.ClassroomDetailController">

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="70.0" prefWidth="1200.0" spacing="20.0" styleClass="dashboard-header">
        <padding>
            <Insets left="20.0" right="20.0" />
        </padding>
        <children>
            <Label fx:id="classroomNameLabel" styleClass="dashboard-title" text="Classroom Name">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
            <Button onAction="#goBackToDashboard" styleClass="btn-secondary" text="Back" />
        </children>
    </HBox>

    <!-- TABS FOR DIFFERENT SECTIONS -->
    <TabPane fx:id="classroomTabs" layoutY="70.0" prefHeight="730.0" prefWidth="1200.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <!-- Routine Tab -->
            <Tab text="Class Routine">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <children>
                        <!-- Admin Action Button -->
                        <HBox spacing="10.0">
                            <Button fx:id="addRoutineBtn" onAction="#goToAddRoutine" styleClass="btn-primary" text="Add Routine" graphicTextGap="8" visible="false">
                                <graphic>
                                    <FontIcon iconLiteral="fas-plus" />
                                </graphic>
                            </Button>
                        </HBox>

                        <ScrollPane fitToWidth="true">
                            <VBox fx:id="routineContainer" spacing="12.0">
                                <padding>
                                    <Insets bottom="20.0" left="10.0" right="20.0" top="10.0" />
                                </padding>
                            </VBox>
                        </ScrollPane>
                    </children>
                </VBox>
            </Tab>

            <!-- Exams Tab -->
            <Tab text="Exams">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <children>
                        <!-- Admin Action Button -->
                        <HBox spacing="10.0">
                            <Button fx:id="addExamBtn" onAction="#goToAddExam" styleClass="btn-primary" text="Add Exam" graphicTextGap="8" visible="false">
                                <graphic>
                                    <FontIcon iconLiteral="fas-plus" />
                                </graphic>
                            </Button>
                        </HBox>

                        <ScrollPane fitToWidth="true">
                            <VBox fx:id="examsContainer" spacing="12.0">
                                <padding>
                                    <Insets bottom="20.0" left="10.0" right="20.0" top="10.0" />
                                </padding>
                            </VBox>
                        </ScrollPane>
                    </children>
                </VBox>
            </Tab>

            <!-- Notices Tab -->
            <Tab text="Notices">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <children>
                        <!-- Admin Action Button -->
                        <HBox spacing="10.0">
                            <Button fx:id="addNoticeBtn" onAction="#goToAddNotice" styleClass="btn-primary" text="Add Notice" graphicTextGap="8" visible="false">
                                <graphic>
                                    <FontIcon iconLiteral="fas-plus" />
                                </graphic>
                            </Button>
                        </HBox>

                        <ScrollPane fitToWidth="true">
                            <VBox fx:id="noticesContainer" spacing="12.0">
                                <padding>
                                    <Insets bottom="20.0" left="10.0" right="20.0" top="10.0" />
                                </padding>
                            </VBox>
                        </ScrollPane>
                    </children>
                </VBox>
            </Tab>

            <!-- CT/Quiz Tab -->
            <Tab text="CT/Quiz">
                <ScrollPane fitToWidth="true">
                    <VBox fx:id="ctQuizContainer" spacing="12.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- Lab Tests Tab -->
            <Tab text="Lab Tests">
                <ScrollPane fitToWidth="true">
                    <VBox fx:id="labTestContainer" spacing="12.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </ScrollPane>
            </Tab>
        </tabs>
    </TabPane>
</AnchorPane>
