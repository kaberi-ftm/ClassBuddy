<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.lang.String?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.classbuddy.controller.AttendanceAnalyticsController">

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <!-- Sidebar -->
    <VBox prefWidth="250" minWidth="250" maxWidth="250" styleClass="sidebar" VBox.vgrow="ALWAYS">
        <VBox styleClass="sidebar-header" alignment="CENTER">
            <Label text="Attendance" styleClass="sidebar-logo" />
        </VBox>

        <VBox styleClass="sidebar-menu" spacing="5" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="10" bottom="10" />
            </padding>

            <Button onAction="#goBack" styleClass="sidebar-item" text="Back to Dashboard" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
        </VBox>
    </VBox>

    <!-- Main Content -->
    <VBox spacing="15" styleClass="main-container" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button text="Back" onAction="#goBack" styleClass="btn-secondary" />
            <Label fx:id="classroomNameLabel" styleClass="page-title" text="Attendance Analytics" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Export CSV" onAction="#handleExportCsv" styleClass="btn-primary" />
        </HBox>

        <Separator />

        <TableView fx:id="statsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="rollColumn" text="Roll" prefWidth="120" />
                <TableColumn fx:id="nameColumn" text="Student Name" prefWidth="260" />
                <TableColumn fx:id="presentColumn" text="Present" prefWidth="100" />
                <TableColumn fx:id="absentColumn" text="Absent" prefWidth="100" />
                <TableColumn fx:id="lateColumn" text="Late" prefWidth="100" />
                <TableColumn fx:id="percentageColumn" text="Percent" prefWidth="100" />
            </columns>
        </TableView>

        <Label fx:id="exportStatusLabel" text="Shows per-student attendance stats for this classroom." styleClass="info-text" />
    </VBox>
</HBox>
