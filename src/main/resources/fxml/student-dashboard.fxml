<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox minHeight="700.0" minWidth="1000.0" prefHeight="800.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.classbuddy.controller.StudentDashboardController">

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <!-- Sidebar -->
    <VBox prefWidth="250.0" minWidth="250.0" maxWidth="250.0" styleClass="sidebar" VBox.vgrow="ALWAYS">
        <!-- Logo Header -->
        <VBox styleClass="sidebar-header" alignment="CENTER">
            <ImageView fitWidth="180.0" preserveRatio="true">
                <image>
                    <Image url="/img/classbuddy_logo.png" />
                </image>
            </ImageView>
        </VBox>

        <!-- Navigation Menu -->
        <VBox styleClass="sidebar-menu" spacing="5" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="10" bottom="10" />
            </padding>
            <Button onAction="#goToDashboard" styleClass="sidebar-item, sidebar-item-active" text="Dashboard" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-home" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToJoinClassroom" styleClass="sidebar-item" text="Join Classroom" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-link" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
        </VBox>

        <!-- User Info Footer -->
        <VBox styleClass="sidebar-footer">
            <VBox styleClass="sidebar-user-info" spacing="5">
                <Label fx:id="studentNameLabel" styleClass="sidebar-username" text="Student" />
                <Label styleClass="sidebar-role" text="Student" />
                <Button onAction="#goToProfile" styleClass="sidebar-profile-btn" text="View Profile" maxWidth="Infinity">
                    <VBox.margin>
                        <Insets top="5" />
                    </VBox.margin>
                </Button>
            </VBox>
            <Button onAction="#handleLogout" styleClass="btn-danger" text="Logout" maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="10" />
                </VBox.margin>
            </Button>
        </VBox>
    </VBox>

    <!-- Main Content Area -->
    <VBox HBox.hgrow="ALWAYS" styleClass="content-area">
        
        <!-- Content Header -->
        <VBox styleClass="content-header">
            <Label styleClass="page-title" text="My Classrooms">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label styleClass="page-subtitle" text="View all your enrolled classrooms" style="-fx-padding: 0 0 8 0;" />
        </VBox>

        <!-- Content Body -->
        <VBox styleClass="content-body" spacing="20" VBox.vgrow="ALWAYS">
            
            <!-- Action Buttons -->
            <HBox spacing="15">
                <Button onAction="#goToJoinClassroom" styleClass="btn-primary" text="Join New Classroom" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#initialize" styleClass="btn-ghost" text="Refresh" />
            </HBox>

            <!-- Classrooms Grid -->
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <VBox fx:id="classroomsContainer" spacing="15" />
            </ScrollPane>
            
        </VBox>
    </VBox>
</HBox>
