<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.classbuddy.controller.NotificationCenterController"
            stylesheets="@../css/app-theme.css">
    
    <top>
        <VBox spacing="12" styleClass="content-header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Back" onAction="#handleGoBack" styleClass="btn-secondary"/>
                <Label text="Notification Center" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Mark All Read" onAction="#handleMarkAllRead" styleClass="btn-primary"/>
                <Button text="Clear All" onAction="#handleClearAll" styleClass="btn-danger"/>
            </HBox>
            
            <HBox spacing="12" styleClass="notification-toolbar">
                <Label text="Search:" styleClass="notification-toolbar-label"/>
                <TextField fx:id="searchField" promptText="Search notifications..." HBox.hgrow="ALWAYS" maxWidth="400"/>
                <Label text="Type:" styleClass="notification-toolbar-label"/>
                <ComboBox fx:id="typeFilter" prefWidth="150"/>
            </HBox>
            
            <HBox spacing="20" styleClass="notification-stats">
                <Label text="Total:" styleClass="notification-stat-label"/>
                <Label fx:id="totalCountLabel" text="0" styleClass="notification-count notification-count-total"/>
                <Label text="Unread:" styleClass="notification-stat-label"/>
                <Label fx:id="unreadCountLabel" text="0" styleClass="notification-count notification-count-unread"/>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="notificationContainer" spacing="8" styleClass="notification-list">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
