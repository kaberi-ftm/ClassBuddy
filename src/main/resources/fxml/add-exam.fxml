<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox minHeight="700.0" minWidth="1000.0" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.classbuddy.controller.AddExamController">

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <!-- Sidebar -->
    <VBox prefWidth="250.0" minWidth="250.0" maxWidth="250.0" styleClass="sidebar" VBox.vgrow="ALWAYS">
        <VBox styleClass="sidebar-header" alignment="CENTER">
            <ImageView fitWidth="180.0" preserveRatio="true" styleClass="sidebar-logo-image">
                <image>
                    <Image url="/img/classbuddy_logo.png" />
                </image>
            </ImageView>
        </VBox>

        <VBox styleClass="sidebar-menu" spacing="5" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="10" bottom="10" />
            </padding>
            <Button onAction="#goBack" styleClass="sidebar-item" text="Back" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT" cancelButton="true">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToAddRoutine" styleClass="sidebar-item" text="Add Routine" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-calendar-plus" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button styleClass="sidebar-item, sidebar-item-active" text="Add Exam" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-plus" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToAddCTQuiz" styleClass="sidebar-item" text="Add Test (CT/Quiz)" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-clipboard-list" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToAddLabTest" styleClass="sidebar-item" text="Add Lab Test" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-flask" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToAddNotice" styleClass="sidebar-item" text="Add Notice" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-bullhorn" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
        </VBox>

        <VBox styleClass="sidebar-footer">
            <VBox styleClass="sidebar-user-info" spacing="5">
                <Label fx:id="classroomNameLabel" styleClass="sidebar-username" text="Classroom" wrapText="true" />
                <Label styleClass="sidebar-role" text="Classroom" />
            </VBox>
        </VBox>
    </VBox>

    <!-- Main Content -->
    <VBox HBox.hgrow="ALWAYS" styleClass="content-area">
        <VBox styleClass="content-header">
            <Label styleClass="page-title" text="Add Exam">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label styleClass="page-subtitle" text="Schedule a new exam" />
        </VBox>

        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox styleClass="content-body" spacing="20">
                <VBox styleClass="card" spacing="14" maxWidth="700">
                    <Label styleClass="card-title" text="Exam details" />

                    <Label fx:id="messageLabel" managed="false" visible="false" wrapText="true" styleClass="error-message" />

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Course Name *" />
                        <TextField fx:id="courseNameField" prefWidth="400.0" promptText="e.g., Data Structures" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Exam Type *" />
                        <ComboBox fx:id="examTypeComboBox" prefWidth="300.0" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Exam Date *" />
                        <DatePicker fx:id="examDatePicker" prefWidth="300.0" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Exam Time (h:mm AM/PM) *" />
                        <ComboBox fx:id="examTimeComboBox" prefWidth="200.0" promptText="14:00" editable="true" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Room" />
                        <TextField fx:id="roomField" prefWidth="300.0" promptText="e.g., Exam Hall 1" />
                    </VBox>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleAddExam" styleClass="btn-primary" text="Add" defaultButton="true" />
                    </HBox>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
