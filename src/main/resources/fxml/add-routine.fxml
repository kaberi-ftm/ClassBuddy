<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox minHeight="700.0" minWidth="1000.0" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.classbuddy.controller.AddRoutineController">

    <fx:define>
        <ToggleGroup fx:id="scheduleModeGroup" />
    </fx:define>

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <!-- Sidebar -->
    <VBox prefWidth="250.0" minWidth="250.0" maxWidth="250.0" styleClass="sidebar" VBox.vgrow="ALWAYS">
        <VBox styleClass="sidebar-header" alignment="CENTER">
            <ImageView fitWidth="180.0" preserveRatio="true" styleClass="sidebar-logo-image">
                <image>
                    <Image url="/img/classbuddy_logo.png" />
                </image>
            </ImageView>
        </VBox>

        <VBox styleClass="sidebar-menu" spacing="5" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="10" bottom="10" />
            </padding>
            <Button onAction="#goBack" styleClass="sidebar-item" text="Back" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT" cancelButton="true">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button styleClass="sidebar-item, sidebar-item-active" text="Add Routine" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-plus" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToAddExam" styleClass="sidebar-item" text="Add Exam" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-clipboard-list" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToAddCTQuiz" styleClass="sidebar-item" text="Add Test" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-tasks" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToAddLabTest" styleClass="sidebar-item" text="Add Lab Test" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-flask" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
            <Button onAction="#goToAddNotice" styleClass="sidebar-item" text="Add Notice" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <FontIcon iconLiteral="fas-bullhorn" styleClass="sidebar-item-icon" />
                </graphic>
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
        </VBox>

        <VBox styleClass="sidebar-footer">
            <VBox styleClass="sidebar-user-info" spacing="5">
                <Label fx:id="classroomNameLabel" styleClass="sidebar-username" text="Classroom" wrapText="true" />
                <Label styleClass="sidebar-role" text="Classroom" />
            </VBox>
        </VBox>
    </VBox>

    <!-- Main Content -->
    <VBox HBox.hgrow="ALWAYS" styleClass="content-area">
        <VBox styleClass="content-header">
            <Label styleClass="page-title" text="Add Routine">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label styleClass="page-subtitle" text="Add a class to the weekly routine" />
        </VBox>

        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox styleClass="content-body" spacing="20">

                <VBox styleClass="card" spacing="14" maxWidth="700">
                    <Label styleClass="card-title" text="Routine details" />

                    <Label fx:id="messageLabel" managed="false" visible="false" wrapText="true" styleClass="error-message" />

                    <VBox spacing="10">
                        <Label styleClass="field-label" text="How often does this class run?" />

                        <RadioButton fx:id="specificDayRadio" text="Specific day only" toggleGroup="$scheduleModeGroup" />
                        <RadioButton fx:id="fullWeekRadio" text="Full week (Monday-Sunday)" toggleGroup="$scheduleModeGroup" />
                        <RadioButton fx:id="customDaysRadio" text="Custom days" toggleGroup="$scheduleModeGroup" />
                    </VBox>

                    <VBox fx:id="specificDayBox" spacing="8">
                        <Label styleClass="field-label" text="Day" />
                        <ComboBox fx:id="dayComboBox" prefWidth="300.0" />
                    </VBox>

                    <VBox fx:id="fullWeekBox" spacing="8" managed="false" visible="false">
                        <Label styleClass="page-subtitle" text="This routine will apply to every day of the week." wrapText="true" />
                    </VBox>

                    <VBox fx:id="customDaysBox" spacing="8" managed="false" visible="false">
                        <Label styleClass="field-label" text="Select days" />
                        <HBox spacing="12">
                            <CheckBox fx:id="mondayCheck" text="Mon" />
                            <CheckBox fx:id="tuesdayCheck" text="Tue" />
                            <CheckBox fx:id="wednesdayCheck" text="Wed" />
                            <CheckBox fx:id="thursdayCheck" text="Thu" />
                            <CheckBox fx:id="fridayCheck" text="Fri" />
                            <CheckBox fx:id="saturdayCheck" text="Sat" />
                            <CheckBox fx:id="sundayCheck" text="Sun" />
                        </HBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Period Number" />
                        <TextField fx:id="periodNumberField" prefWidth="300.0" promptText="e.g., 1, 2, 3" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Course Name *" />
                        <TextField fx:id="courseNameField" prefWidth="400.0" promptText="e.g., Data Structures" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Teacher Name" />
                        <TextField fx:id="teacherNameField" prefWidth="400.0" promptText="e.g., Dr. John Doe" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Room" />
                        <TextField fx:id="roomField" prefWidth="300.0" promptText="e.g., Room 301" />
                    </VBox>

                    <HBox spacing="20.0">
                        <VBox spacing="8">
                            <Label styleClass="field-label" text="Start Time (h:mm AM/PM) *" />
                            <ComboBox fx:id="timeStartComboBox" prefWidth="150.0" promptText="09:00" editable="true" />
                        </VBox>
                        <VBox spacing="8">
                            <Label styleClass="field-label" text="End Time (h:mm AM/PM) *" />
                            <ComboBox fx:id="timeEndComboBox" prefWidth="150.0" promptText="10:00" editable="true" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleAddRoutine" styleClass="btn-primary" text="Add" defaultButton="true" />
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
