<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.classbuddy.controller.AttendanceMarkerController">

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <!-- Sidebar -->
    <VBox prefWidth="250" minWidth="250" maxWidth="250" styleClass="sidebar" VBox.vgrow="ALWAYS">
        <VBox styleClass="sidebar-header" alignment="CENTER">
            <Label text="Attendance" styleClass="sidebar-logo" />
        </VBox>

        <VBox styleClass="sidebar-menu" spacing="5" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="10" bottom="10" />
            </padding>

            <Button onAction="#goBack" styleClass="sidebar-item" text="Back to Dashboard" graphicTextGap="10" maxWidth="Infinity" alignment="CENTER_LEFT">
                <padding>
                    <Insets left="25" />
                </padding>
            </Button>
        </VBox>
    </VBox>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" fitToHeight="true" HBox.hgrow="ALWAYS">
        <VBox spacing="24" styleClass="main-container">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <!-- Header -->
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Button text="← Back" onAction="#goBack" styleClass="btn-secondary"/>
                    <Label text="Mark Attendance" styleClass="page-title"/>
                </HBox>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Classroom:" styleClass="field-label"/>
                        <Label fx:id="classroomNameLabel" text="Loading..." styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox spacing="4">
                        <Label text="Date:" styleClass="field-label"/>
                        <DatePicker fx:id="datePicker" prefWidth="150"/>
                    </VBox>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Status Message -->
            <Label fx:id="statusLabel" wrapText="true" styleClass="field-help"/>

            <!-- Quick Actions -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="markAllPresentButton" text="Mark All Present" onAction="#handleMarkAllPresent" styleClass="btn-secondary"/>
                <Label text="Quick action to mark everyone as present" styleClass="field-help"/>
            </HBox>

            <!-- Attendance Table -->
            <VBox spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Student Attendance" styleClass="card-title"/>
                
                <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="rollColumn" text="Roll Number" prefWidth="150" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="nameColumn" text="Student Name" prefWidth="300"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="200" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancel" onAction="#goBack" styleClass="btn-secondary"/>
                <Button fx:id="saveButton" text="Save Attendance" onAction="#handleSave" styleClass="btn-primary" defaultButton="true"/>
            </HBox>

            <!-- Info Box -->
            <VBox spacing="8" styleClass="callout callout-info">
                <Label text="ℹ Attendance Instructions" styleClass="callout-title"/>
                <Label text="• Use the date picker to select the date for marking attendance" wrapText="true" styleClass="field-help"/>
                <Label text="• Select status for each student: Present, Absent, or Late" wrapText="true" styleClass="field-help"/>
                <Label text="• Use 'Mark All Present' for quick marking when most students are present" wrapText="true" styleClass="field-help"/>
                <Label text="• You can update attendance for past dates if needed" wrapText="true" styleClass="field-help"/>
                <Label text="• Only active students are shown in the list" wrapText="true" styleClass="field-help"/>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
