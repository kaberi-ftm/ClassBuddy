<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.classbuddy.controller.IntegratedCalendarController"
      spacing="15" VBox.vgrow="ALWAYS">

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <!-- Calendar Controls -->
    <VBox styleClass="card" spacing="15">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <!-- View Switcher and Navigation -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <!-- View Switcher -->
            <HBox fx:id="viewSwitcher" spacing="5" styleClass="button-group">
                <Button fx:id="monthViewBtn" text="Month" styleClass="btn-primary" minWidth="80"/>
                <Button fx:id="weekViewBtn" text="Week" styleClass="btn-ghost" minWidth="80"/>
                <Button fx:id="dayViewBtn" text="Day" styleClass="btn-ghost" minWidth="80"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Navigation Controls -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="prevBtn" text="◄" styleClass="btn-ghost" minWidth="40"/>
                <Label fx:id="calendarTitle" text="January 2024" styleClass="calendar-month-year" 
                       style="-fx-text-fill: -text-primary; -fx-font-size: 18; -fx-font-weight: bold; -fx-min-width: 200; -fx-alignment: center;"/>
                <Button fx:id="nextBtn" text="►" styleClass="btn-ghost" minWidth="40"/>
                <Button fx:id="todayBtn" text="Today" styleClass="btn-primary" minWidth="80"/>
                <Region minWidth="20" />
                <Label fx:id="countdownLabel" text="" style="-fx-text-fill: -text-light; -fx-font-size: 12;" />
            </HBox>
        </HBox>
    </VBox>

    <!-- Calendar Content Area -->
    <HBox spacing="15" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
        
        <!-- Main Calendar View -->
        <VBox fx:id="calendarContent" styleClass="card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
        </VBox>

        <!-- Event Details Panel -->
        <VBox fx:id="eventDetailsPanel" spacing="15" prefWidth="320" minWidth="320" maxWidth="320">
            
            <!-- Selected Date Header -->
            <VBox styleClass="card" spacing="10">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <Label text="Selected Date" style="-fx-text-fill: -text-light; -fx-font-size: 11; -fx-font-weight: 600;"/>
                <Label fx:id="selectedDateLabel" text="Today" 
                       style="-fx-text-fill: -text-primary; -fx-font-size: 15; -fx-font-weight: bold;" 
                       wrapText="true"/>
            </VBox>

            <!-- Events List -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <Label text="Events &amp; Classes" 
                       style="-fx-text-fill: -text-primary; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                    <VBox fx:id="eventsList" spacing="10" style="-fx-background-color: transparent;"/>
                </ScrollPane>
            </VBox>
            
        </VBox>
        
    </HBox>

</VBox>
