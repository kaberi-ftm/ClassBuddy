<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.classbuddy.controller.TimetableGridController"
      styleClass="timetable-root" VBox.vgrow="ALWAYS">

    <stylesheets>
        <String fx:value="/css/app-theme.css" />
    </stylesheets>

    <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="false" pannable="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <content>
            <GridPane fx:id="grid" hgap="8" vgap="8" styleClass="timetable-grid">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10" />
                </padding>
            </GridPane>
        </content>
    </ScrollPane>
</VBox>
